# Powers every form on the site (Contact page + listing inquiries) so submissions
# actually email Claire instead of going nowhere.
#
# Setup (takes ~5 minutes):
#   1. Go to https://web3forms.com and sign up using Claire's email
#      (clairesellsthecoast@gmail.com).
#   2. Copy the access key it gives you.
#   3. Create a file named .env.local in this same folder (copy this file and
#      rename it) and paste the key below.
#   4. Restart the dev server / redeploy so the new value is picked up.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# The site's real, live production domain. This feeds every canonical URL,
# the sitemap, and Open Graph/social share tags — required for SEO to work
# correctly. Defaults to https://clairesellsthecoast.com if unset; only set
# this if the final domain is different.
NEXT_PUBLIC_SITE_URL=
